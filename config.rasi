configuration {
    modi: "drun";
    combi-hide-mode-prefix: true;
}

/* Global configurations and color mapping */
* {
    /* Uses the clean, modern JetBrains Mono font family */
    font: "JetBrains Mono 24"; 

    /* Format: #RRGGBBAA (AA is transparency: 00 = invisible, FF = solid) */
    bg-main:       #00000099; /* 60% translucent black window background */
    bg-button:     #0000004D; /* 30% translucent black button background */
    bg-selected:   #000000B3; /* 70% translucent black for hovered buttons */
    
    text-normal:   #FFFFFFEF; /* Crisp near-white text */
    text-selected: #FFFFFFFF; /* Pure white text for selection */
    
    /* Force inherit transparency across default structural elements */
    background-color: transparent;
    text-color:       @text-normal;
}

/* Compact Window Container */
window {
    transparency:     "real"; /* Required for compositor transparency */
    background-color: @bg-main;
    border-radius:    8px;
    border:           1px;
    border-color:     #ffffff1a; /* Subtle white border outline */
    padding:          12px;
    width:            32%; /* Slimmer look */

    location: south;
    anchor: south;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

/* Shrunk Text Input Bar */

prompt {
    enabled: false;
}

entry {
    placeholder:       "Search apps...";
    placeholder-color: #ffffff66;
    text-color:         #ffffffb3; /* translucent white caret + typed text */
}

inputbar {
    background-color: @bg-button;
    padding:          6px 10px;
    border-radius:    6px;
    margin:           0px 0px 8px 0px;
    border:           0px;
    children:         [ entry ];
}


/* Compact Application List Container */
listview {
    columns:       1;
    lines:         6;
    cycle:         true;
    scrollbar:     false;
    spacing:       8px;
    border:        0px;
}
/* Unselected Translucent Black Buttons */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: @bg-button;
    text-color:       @text-normal;
    padding:          6px 8px;
    border-radius:    6px;
}

/* Text and Icon alignment inside buttons */
element-text, element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             24px; /* Matches the text size */
}

/* Hovered / Active Selection Buttons */
element selected.normal,
element selected.active {
    background-color: @bg-selected;
    text-color:       @text-selected;
    padding:          6px 8px;
    border-radius:    6px;
}

